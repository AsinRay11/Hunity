float getSpectrumMultiplier(int spectrumNumber)
{
  return spectrumMultiplier[spectrumNumber];
}

float getCalibrationMultiplier(short int temp)
{
  if(temp > 127)//ha overflowolt a hőmérséklet
  {
    temp -= 255;
  }

  if(temp<-13)
  {
    return heatCompAproxCoef*temp + heatCompAproxConst;
  }
  else if(temp > 54)
  {
    return calibrationPoints[ARRAY_LENGTH-1].y;
  }
  else
  {
    for(uint8_t i = 0; i < ARRAY_LENGTH; i++)
    {
      if(temp <= calibrationPoints[i].x)
      {
        return calibrationPoints[i].y;        
      }
    }
  }

  return 1;
}
